{
  "compilerOptions": {
    "module": "commonjs",
    "esModuleInterop": true,
    "target": "es6",
    "moduleResolution": "node",
    "sourceMap": true,
    "outDir": "./src/dist",
    "resolveJsonModule": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts"],
  "exclude": [
    "./node_modules",
    "./encryptHistoricalData.ts",
    "./check_*.ts",
    "./inspect_*.ts",
    "./src/**/*_backup.ts",
    "./src/controllers/EnhancedCaseController.ts",
    "./src/controllers/DocumentControllerEnhanced.ts",
    "./src/controllers/EnhancedDocumentController.ts",
    "./src/controllers/QuestionControllerFixed.ts",
    "./src/utils/fcmNotification.ts",
    "./src/migrations/**"
  ],
  "lib": ["es2015"]
}
